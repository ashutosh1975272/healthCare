# VPS environment — copy to `.env.vps` on the VPS host and fill in REAL values.
# NEVER commit `.env.vps` (it holds rotated production secrets).
# LiveKit project rule: backend, worker AND this file must all use the SAME
# project. Canonical: wss://gggg-2bqk2rxr.livekit.cloud — never mix projects
# (a second project id floating in repo docs is stale; ignore it).

# Domain served by Caddy (DNS A-record must point at the VPS first)
DOMAIN=app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Optional: comma-separated browser origins for CORS. Unset = builtin default list.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
HTTPS_PORT=20354

# --- App core (copy SECRET_KEY verbatim from Render — sessions/JWTs depend on it) ---
APP_ENV=production
SECRET_KEY=REPLACE_ME_COPY_VERBATIM
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- MinIO (VPS-local object storage for reports) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_ME_LONG_RANDOM

# --- SMTP (email OTP; Gmail app password, rotated) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD="REPLACE_ME_APP_PASSWORD"
SMTP_FROM_NAME=Aarogya
SMTP_FROM_ADDRESS=REPLACE_ME
OTP_DEV_MODE=false
OTP_DEV_CODE=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Telegram (user-provided bot token per BYOK rule) ---
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_URL=https://app.example.com

# --- AI providers (server fallbacks; per-user keys come from Profile/BYOK) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- LiveKit (SAME project everywhere: URL + key + secret as one set) ---
LIVEKIT_URL=wss://gggg-2bqk2rxr.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Feature flags (dark until verified on the VPS, then true) ---
XOMNI_CONTEXT_ASSEMBLY=false
