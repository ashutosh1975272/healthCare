# Caddy reverse proxy for the VPS deployment.
# TLS is manual (DNS-01 certs issued by certbot, mounted read-only).
# HTTP is intentionally disabled because port 80 is taken on this host.
# HTTPS_PORT is set from environment; default 20354 for shared VPS hosts.
{
	auto_https off
}

{$DOMAIN} {
	# Manual TLS — certs issued externally and mounted read-only.
	tls /certs/fullchain.pem /certs/privkey.pem

	encode gzip

	# Backend API (chat, auth, voice tokens, Telegram webhook, health).
	# The Vercel frontend proxies /api/* here via API_INTERNAL_URL.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}

	# No frontend on this host by design (Vercel serves the UI).
	# Anything else gets a plain 404 from Caddy.
	handle {
		respond "Aarogya API — see /health" 404
	}
}
