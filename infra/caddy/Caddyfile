# Caddy reverse proxy for the VPS deployment.
# DOMAIN comes from the environment (export DOMAIN=... before compose up).
# Caddy provisions and renews Let's Encrypt certificates automatically.
# Plain HTTP is redirect-upgraded; mic access + Telegram webhooks require it.
{
	auto_https on
}

{$DOMAIN} {
	encode gzip

	# Backend API (chat, auth, voice tokens, Telegram webhook, health).
	# The Vercel frontend proxies /api/* here via API_INTERNAL_URL.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}

	# No frontend on this host by design (Vercel serves the UI).
	# Anything else gets a plain 404 from Caddy.
	handle {
		respond "Aarogya API — see /health" 404
	}
}
